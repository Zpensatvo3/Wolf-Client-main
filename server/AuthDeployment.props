<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Public deployment metadata only. Projects emit ONESTEP_AUTH_* definitions.
       The production hostname and public verification key are required; no fallback. -->
  <PropertyGroup>
    <AuthRequired Condition="'$(AuthRequired)' == ''">true</AuthRequired>
    <AuthServerDomain>onestep-auth.gogogamesas.workers.dev</AuthServerDomain>
    <!-- Public verification material, NOT a secret. Private key exists only in Cloudflare.
         Matches staged signing release onestep-20261020-7615fc79. -->
    <AuthPublicKeySpkiBase64>MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEqXfwmjYj4Z7EWgua6G7ppDjK3CROxJWau7QQ9bl5VlakFj6wn5u5c2t3E6WqzArtg58PDnJwny06ukO0n3aROg</AuthPublicKeySpkiBase64>
  </PropertyGroup>
</Project>
