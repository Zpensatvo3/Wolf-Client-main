{
  "name": "onestep-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node tools/check-security-config.mjs",
    "deploy": "wrangler deploy --keep-vars",
    "check": "wrangler deploy --dry-run",
    "test": "node --test ../tests/auth_server_policy_test.mjs ../tests/device_proof_test.mjs ../tests/launcher_test.mjs ../tests/auth_worker_test.mjs ../tests/auth_hardening_test.mjs ../tests/dashboard_test.mjs",
    "test:browser": "node --test ../tests/dashboard_browser_test.mjs",
    "test:bundle": "node --test ../tests/dashboard_bundle_test.mjs",
    "test:runtime": "node --test ../tests/worker_runtime_test.mjs",
    "test:v2": "node --test ../tests/launcher_v2_test.mjs",
    "test:v2:runtime": "node --test ../tests/launcher_v2_runtime_test.mjs"
  },
  "dependencies": {
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "wrangler": "^4.151.1"
  }
}
